<script>

const cartTotal = {{ $cartTotal }};

document.querySelectorAll('.shipping-option').forEach(function(radio){

    radio.addEventListener('change', function(){

        const price = parseFloat(this.dataset.price);
        const total = cartTotal + price;

        document.getElementById('shipping_display').textContent =
            price > 0 ? 'R$ ' + price.toFixed(2).replace('.', ',') : 'Grátis';

        document.getElementById('total_display').textContent =
            'R$ ' + total.toFixed(2).replace('.', ',');

    });

});

</script>

